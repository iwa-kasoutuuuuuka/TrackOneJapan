<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降: クラウドのバックアップにも、機種変更時の引き継ぎにも、アプリのデータを含めない（ログイン用の鍵を守るため） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
